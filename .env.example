# SentinelFlow AI - Environment Configuration Example
# Copy this file to .env and set your credentials. Never commit real keys.

# ==============================================================================
# 1. Google Gemini AI Model Configuration
# ==============================================================================
# Google Gemini API Key (Optional for deterministic demo mode, required for live AI analysis)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Operational Mode: 'auto' (uses Gemini if key present, else fallback), 'gemini_only', or 'deterministic'
SENTINELFLOW_MODE=auto

# ==============================================================================
# 2. Firebase Authentication & Project Settings
# ==============================================================================
# Your Firebase Project ID from Google Cloud / Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id-placeholder

# Path to the Google Cloud / Firebase Service Account JSON file (Hosting secrets only)
# Alternatively, configure via GOOGLE_APPLICATION_CREDENTIALS
# Note: In Streamlit Community Cloud or Docker, supply credentials via environment secrets
FIREBASE_CREDENTIALS_PATH=

# Secret key used for cryptographic session signing and state hashing
SESSION_SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# ==============================================================================
# 3. Rate Limiting & Abuse Prevention
# ==============================================================================
# Redis URL for atomic, distributed sliding-window rate limiting across instances
# Example: redis://:your_password@redis-server:6379/0
# If left blank, falls back to in-memory sliding window rate limiter
REDIS_URL=

# Operation Rate Limits (format: requests/window_seconds)
RATE_LIMIT_AI_INVESTIGATION=5/60
RATE_LIMIT_RESPONSE_ACTION=10/60
RATE_LIMIT_AUTH_ATTEMPT=5/300
RATE_LIMIT_DEMO_MUTATION=20/60

# Number of trusted reverse proxies between internet and Streamlit server
# Used by get_trusted_client_ip to safely parse X-Forwarded-For headers
TRUSTED_PROXY_COUNT=1

# ==============================================================================
# 4. Web & Deployment Environment
# ==============================================================================
# Application Environment: 'development', 'staging', 'production'
ENVIRONMENT=development

# Streamlit Server Port (Default: 8501)
PORT=8501
