# SentinelFlow AI - Production Caddyfile Reverse Proxy
# Provides automatic HTTPS, HSTS, and WebSocket support for Streamlit.

sentinelflow.ai, www.sentinelflow.ai {
    # Force HTTPS & modern security headers
    header {
        # Strict-Transport-Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # Clickjacking & MIME-sniffing protection
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Content Security Policy for Streamlit & Fonts
        Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' wss: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' https://fonts.googleapis.com 'unsafe-inline';"
    }

    # PWA Service Worker & Manifest handling with global scope
    handle /service-worker.js {
        rewrite * /app/static/service-worker.js
        header +Service-Worker-Allowed "/"
        header +Content-Type "application/javascript"
        reverse_proxy localhost:8501
    }

    handle /manifest.json {
        rewrite * /app/static/manifest.json
        header +Content-Type "application/manifest+json"
        reverse_proxy localhost:8501
    }

    handle /robots.txt {
        rewrite * /app/static/robots.txt
        header +Content-Type "text/plain"
        reverse_proxy localhost:8501
    }

    handle /sitemap.xml {
        rewrite * /app/static/sitemap.xml
        header +Content-Type "application/xml"
        reverse_proxy localhost:8501
    }

    # Proxy all other routes to Streamlit
    handle {
        reverse_proxy localhost:8501 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
}
